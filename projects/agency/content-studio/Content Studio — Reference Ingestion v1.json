        400
      ],
      "id": "f0271b24-dd10-4853-9a7c-c46a6684e192"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst interiorPrompt = `You are a visual analyst for a hospitality content system. Analyze the provided restaurant interior reference image and return structured metadata that will compose image-generation prompts for in-situ food photography.\nReturn ONLY a JSON object matching this schema:\n{\n  \"summary\": \"one sentence describing the space, max 25 words\",\n  \"palette\": [\"3-6 dominant colors in plain English, e.g. 'deep navy', 'warm brass'\"],\n  \"lighting\": \"light source, color temperature, shadow quality\",\n  \"materials\": [\"3-6 architectural/upholstery materials, e.g. 'dark walnut wood', 'red velvet upholstery'\"],\n  \"mood\": \"3-5 descriptors comma-separated, e.g. 'intimate, opulent, evening'\",\n  \"composition_cues\": \"spatial layering, depth, what is visible in background\"\n}\nRules:\n- Be specific to what is actually in the image. 'Warm brass chandeliers' beats 'lighting fixtures'.\n- Describe what IS visible, not generic restaurant tropes.\n- No prose outside the JSON object.`;\n\nconst stylePrompt = `You are a visual analyst for a hospitality content system. Analyze the provided food-styling reference image and return structured metadata that will compose image-generation prompts for plated dish photography.\nReturn ONLY a JSON object matching this schema:\n{\n  \"summary\": \"one sentence describing the styling approach, max 25 words\",\n  \"plating_style\": \"geometry, layering, negative space, height profile\",\n  \"surface\": \"what the dish sits on - material, texture, color (slate, linen, marble, weathered wood, etc.)\",\n  \"props\": [\"cutlery, glassware, fabric, jars, herbs in frame beyond the dish itself\"],\n  \"garnish\": \"herb, sauce dot, oil sheen, dust pattern - finishing touches on the food\",\n  \"lighting_on_food\": \"direction, hardness, highlight quality on the dish\",\n  \"mood\": \"3-5 descriptors comma-separated\"\n}\nRules:\n- Be specific to what is in this image.\n- No prose outside the JSON object.`;\n\nconst systemPrompt = item.category === 'interior' ? interiorPrompt : stylePrompt;\n\n// Build the full OpenAI Vision payload as a JS object here, so the downstream\n// HTTP node can JSON.stringify() it natively. This avoids the n8n fixed-mode body\n// bug where multi-line systemPrompt with embedded newlines/quotes shreds JSON\n// validity at the [item 0] validator.\nconst requestBody = {\n  model: 'gpt-4o-2024-08-06',\n  response_format: { type: 'json_object' },\n  max_tokens: 600,\n  messages: [\n    {\n      role: 'user',\n      content: [\n        { type: 'text', text: systemPrompt },\n        { type: 'image_url', image_url: { url: item.reference_url } }\n      ]\n    }\n  ]\n};\n\nreturn [{\n  json: {\n    ...item,\n    systemPrompt,   // kept in output for downstream debug/inspection\n    requestBody\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
        144
      ],
      "id": "070b0d66-166a-4419-974d-025c8b4aa31c",
      "name": "Build Vision Request"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.requestBody) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        448,
        400
      ],
      "id": "a802a873-9e43-40d5-a466-9d8e8beec906",
      "name": "Vision Analyze Reference",
      "credentials": {
        "openAiApi": {
          "id": "bM5k35qHgY126dzI",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const apiResponse = $input.first().json;\nconst ctx = $('Build Vision Request').first().json;\n\nconst visionRaw = apiResponse?.choices?.[0]?.message?.content;\nif (!visionRaw) {\n  throw new Error(`Vision API returned no content. Response: ${JSON.stringify(apiResponse).slice(0, 300)}`);\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(visionRaw);\n} catch (e) {\n  throw new Error(`Vision returned non-JSON: ${visionRaw.slice(0, 200)}`);\n}\n\n// Tag As Interior / Tag As Style sets `reference_type` upstream, but Drive Share Reference\n// (HTTP node) replaces the item with its API response, dropping it. Fetch it directly from\n// whichever Tag node ran for this execution. Defensive try/catch in case n8n throws when\n// referencing a node that didn't run on this path.\nlet category = null;\ntry { category = $('Tag As Interior').first()?.json?.reference_type ?? null; } catch (_) {}\nif (!category) {\n  try { category = $('Tag As Style').first()?.json?.reference_type ?? null; } catch (_) {}\n}\nif (!category) {\n  throw new Error(`Could not determine category — neither Tag As Interior nor Tag As Style produced a reference_type`);\n}\n\nconst referenceMetadata = {\n  url: ctx.reference_url,   // was ctx.referenceUrl — snake_case is correct\n  category,\n  ...parsed,\n  added_at: new Date().toISOString()\n};\n\nreturn [{\n  json: {\n    ...ctx,\n    category,             // expose at top level so Merge can read ctx.category\n    referenceMetadata\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        400
      ],
      "id": "7d937a46-b35a-420d-9e1e-c35bcd84a481",
      "name": "Parse Vision Response"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst ctx = $('Parse Vision Response').first().json;\n\n// Deep-clone existing config so we don't mutate input\nconst config = JSON.parse(JSON.stringify(item.config || {}));\nconfig.references = config.references || {};\nconfig.references.interior = config.references.interior || [];\nconfig.references.style = config.references.style || [];\n\nconst category = ctx.category;\nconst newMeta = ctx.referenceMetadata;\nconst targetArray = config.references[category];\n\n// Dedup by url — handle both legacy bare-string and v1.1 object entries\nconst existingUrls = targetArray.map(entry =>\n  typeof entry === 'string' ? entry : entry.url\n);\n\nlet action;\nif (existingUrls.includes(newMeta.url)) {\n  action = 'skipped_duplicate';\n} else {\n  targetArray.push(newMeta);\n  action = 'appended';\n}\n\nreturn [{\n  json: {\n    ...item,                  // preserve Lookup Tenant Config output (id, tenant_id, etc.)\n    config,                   // overwrite with mutated config\n    action,\n    referenceMetadata: newMeta  // expose for downstream visibility / logging\n  }\n}];"
      },
      "name": "Merge Reference Into Config V2",
